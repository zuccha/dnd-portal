{
  "name": "dnd-portal",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "format": "oxfmt ./src",
    "format:check": "oxfmt --check ./src",
    "lint": "oxlint --fix --deny-warnings",
    "lint:check": "oxlint --deny-warnings",
    "preview": "vite preview",
    "registry:dev": "node --experimental-strip-types registry/server.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.37.0",
    "@emotion/react": "^11.14.0",
    "@supabase/supabase-js": "^2.108.2",
    "@tanstack/react-query": "^5.101.0",
    "dexie": "^4.4.5",
    "lucide-react": "^1.45.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "supabase": "^2.109.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vite-plugin-svgr": "^5.2.0"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,jsx,ts,tsx,json,css,md}": "oxfmt --check",
    "*.{js,cjs,mjs,jsx,ts,tsx}": "oxlint --fix --deny-warnings"
  }
}
